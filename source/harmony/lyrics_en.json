{
  "_comment": "The English version, paired line for line with the Filipino in lyrics.json. Times are copied from there, so they stay on the same clock as the recording: seconds from the start of the file. Shown on 5175 while she sings the Filipino.",
  "song": "Lupang Hinirang",
  "language": "en",
  "paired_with": "lyrics.json",
  "lines": [
    {
      "t": 0.62,
      "end": 3.2,
      "text": "Land of the morning",
      "fil": "Bayang magiliw"
    },
    {
      "t": 3.58,
      "end": 6.16,
      "text": "Child of the sun returning",
      "fil": "Perlas ng Silanganan"
    },
    {
      "t": 6.68,
      "end": 9.2,
      "text": "With fervor burning",
      "fil": "Alab ng puso"
    },
    {
      "t": 9.52,
      "end": 11.98,
      "text": "Thee do our souls adore",
      "fil": "Sa dibdib mo'y buhay"
    },
    {
      "t": 12.62,
      "end": 15.22,
      "text": "Land dear and holy",
      "fil": "Lupang Hinirang"
    },
    {
      "t": 15.6,
      "end": 18.1,
      "text": "Cradle of noble heroes",
      "fil": "Duyan ka ng magiting"
    },
    {
      "t": 18.62,
      "end": 21.2,
      "text": "Ne'er shall invaders",
      "fil": "Sa manlulupig"
    },
    {
      "t": 21.62,
      "end": 23.44,
      "text": "Trample thy sacred shores",
      "fil": "'Di ka pasisiil"
    },
    {
      "t": 23.68,
      "end": 25.94,
      "text": "Ever within thy skies and through thy clouds",
      "fil": "Sa dagat at bundok"
    },
    {
      "t": 26.12,
      "end": 29.54,
      "text": "And o'er thy hills and seas",
      "fil": "Sa simoy at sa langit mong bughaw"
    },
    {
      "t": 29.88,
      "end": 31.92,
      "text": "Do we behold the radiance, feel the throb",
      "fil": "May dilag ang tula"
    },
    {
      "t": 32.12,
      "end": 36.44,
      "text": "Of glorious liberty",
      "fil": "At awit sa paglayang minamahal"
    },
    {
      "t": 36.64,
      "end": 41.44,
      "text": "Thy banner dear to all our hearts",
      "fil": "Ang kislap ng watawat mo'y"
    },
    {
      "t": 41.86,
      "end": 45.04,
      "text": "Its sun and stars alight",
      "fil": "Tagumpay na nagniningning"
    },
    {
      "t": 45.34,
      "end": 48.48,
      "text": "Oh, never shall its shining fields",
      "fil": "Ang bituin at araw niya"
    },
    {
      "t": 48.7,
      "end": 53.48,
      "text": "Be dimmed by tyrant's might!",
      "fil": "Kailan pa ma'y 'di magdidilim"
    },
    {
      "t": 53.88,
      "end": 59.18,
      "text": "Beautiful land of love, o land of light",
      "fil": "Lupa ng araw ng luwalhati't pagsinta"
    },
    {
      "t": 59.78,
      "end": 63.26,
      "text": "In thine embrace 'tis rapture to lie",
      "fil": "Buhay ay langit sa piling mo"
    },
    {
      "t": 63.68,
      "end": 65.62,
      "text": "But it is glory ever, when thou art wronged",
      "fil": "Aming ligaya na 'pag may mang-aapi"
    },
    {
      "t": 65.88,
      "end": 71.36,
      "text": "For us, thy sons to suffer and die",
      "fil": "Ang mamatay ng dahil sa iyo"
    }
  ]
}
