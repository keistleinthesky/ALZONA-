# Copy this file to .env and fill in your own keys. Never commit the real .env.

# --- Google Gemini (chat, vision, speech-to-text, fallback TTS) --------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your-gemini-api-key
# Optional second key. ALZONA fails over to it automatically if the primary
# key is rate-limited or billing-blocked.
GOOGLE_GENAI_API_KEY_BACKUP=your-backup-gemini-api-key

# --- Google Cloud Text-to-Speech (optional secondary voice) ------------------
# Path to a service-account JSON with the Text-to-Speech API enabled.
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account.json
USE_GEMINI_TTS=1

# --- ElevenLabs (optional primary voice) ------------------------------------
# Off by default; ALZONA uses the Gemini "Leda" voice instead.
# Set to 1 to enable, and supply a key from https://elevenlabs.io
USE_ELEVENLABS=0
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Baybayin printing ------------------------------------------------------
# 1 = automatically print each Baybayin sheet, 0 = show on screen only.
BAYBAYIN_AUTOPRINT=1
# Leave blank to use the Windows default printer.
BAYBAYIN_PRINTER=
